{
  "manifest_version": 3,
  "name": "Joinly — Fast Quiz Join",
  "version": "1.0.0",
  "description": "Jump straight into Kahoot, Blooket, Wayground, ClassPoint, or Classkick games with one code.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "https://kahoot.it/*",
    "https://play.blooket.com/*",
    "https://wayground.com/*",
    "https://www.classpoint.app/*",
    "https://classpoint.app/*",
    "https://app.classkick.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.classpoint.app/*", "https://classpoint.app/*"],
      "js": ["content/classpoint.js"],
      "run_at": "document_end"
    }
  ]
}
